# Copy to .env.local for local development. Real values live in Vercel (never commit them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
DATABASE_URL=
CRON_SECRET=
ALLOWED_EMAILS=

# Optional. Signs the chat's Approve/Deny requests so a forged "approved" message is rejected.
# Generate with: openssl rand -base64 32
# Must be the SAME value on every Vercel instance (set it once in Vercel env). Unset or blank = unsigned approvals.
TOOL_APPROVAL_SECRET=
